# Frontend Environment Variables
NEXT_PUBLIC_API_URL=https://api.archazor.uz/api
NEXT_PUBLIC_SITE_URL=https://archazor.uz

# Backend Environment Variables
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=archazor_db;Username=archazor_user;Password=CHANGE_THIS_DATABASE_PASSWORD

# CORS Configuration
AllowedOrigins=https://archazor.uz,https://www.archazor.uz

# Admin Credentials Seed
AdminSeed__Username=admin@archazor.uz
AdminSeed__Password=CHANGE_THIS_SECURE_ADMIN_PASSWORD

# PostgreSQL Setup
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
